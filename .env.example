# Set these in Netlify: Site configuration > Environment variables. Never commit real values.
SQUARE_ACCESS_TOKEN=
SQUARE_ENV=production
# request = customer picks an open time and you get an email to confirm in Square (works on Square Free).
# square  = the site creates the booking in Square itself (needs Appointments Plus or Premium).
BOOKING_MODE=request
# Only used when BOOKING_MODE=square. true = test without creating bookings.
DRY_RUN=true
# Optional. Found automatically if left empty.
SQUARE_LOCATION_ID=
SQUARE_TEAM_MEMBER_ID=
# Optional tuning
MIN_NOTICE_HOURS=12
MAX_DAYS_AHEAD=365

# Optional: Google reviews on the Reviews section (the owner's own reviews live in reviews.json and need nothing).
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
